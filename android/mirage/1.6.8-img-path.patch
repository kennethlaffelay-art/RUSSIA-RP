+// GTA caches this name after opening the archive and later looks for a backslash
+// before choosing a texture database. The Android file hook resolves disk casing.
+static bool WriteGameArchiveName(char (&output)[40], const char *input)
+{
+    unsigned length = 0;
+    unsigned leaf = 0;
+    while (input[length]) {
+        if (length == 39)
+            goto invalid;
+        char c = input[length++];
+        if (c == '/' || c == '\\') {
+            c = '\\';
+            leaf = length;
+        }
+        output[length - 1] = c;
+    }
+    if (length - leaf < 5)
+        goto invalid;
+    output[length] = 0;
+    if (leaf == 0) {
+        if (length > 37)
+            goto invalid;
+        for (unsigned i = length + 1; i != 0; --i)
+            output[i + 1] = output[i - 1];
+        output[0] = '.';
+        output[1] = '\\';
+    }
+    return true;
+invalid:
+    output[0] = 0;
+    return false;
+}
